{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "excludeFiles": "{.env,.env.*,**/.env*,.streamlit/secrets.toml,.venv/**,.vercel/**,.git/**,tests/**,docs/**,tasks/**,demo_data/rag_documents/sources/**,demo_data/rag_documents/text/**,demo_data/sentinel2/*.tif,demo_data/sentinel2/*.zip}",
      "includeFiles": "{app.py,asgi.py,model.py,rag.py,assets/**,prompts/agronomy_rag_v8.txt,demo_data/rag_documents/*.json*,demo_data/sentinel2/*.png,demo_data/comparison/*}"
    }
  },
  "rewrites": [{"source": "/(.*)", "destination": "/api/index"}]
}
